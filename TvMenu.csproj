<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>TvMenu</AssemblyName>
    <Description>TvMenu for Gorilla Tag</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="GorillaTag.GameLibs.Steam" Version="1.1.1-live" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Dynamically locate and include all UnityEngine DLLs from wherever NuGet unpacks them -->
  <Target Name="IncludeGameLibs" BeforeTargets="CollectPackageReferences;FindReferenceAssemblies;ResolveAssemblyReferences">
    <ItemGroup Condition="'$(PkgGorillaTag_GameLibs_Steam)' != ''">
      <Reference Include="$([System.IO.Directory]::GetFiles('$(PkgGorillaTag_GameLibs_Steam)', 'UnityEngine.dll', System.IO.SearchOption.AllDirectories))">
        <Private>false</Private>
      </Reference>
      <Reference Include="$([System.IO.Directory]::GetFiles('$(PkgGorillaTag_GameLibs_Steam)', 'UnityEngine.CoreModule.dll', System.IO.SearchOption.AllDirectories))">
        <Private>false</Private>
      </Reference>
      <Reference Include="$([System.IO.Directory]::GetFiles('$(PkgGorillaTag_GameLibs_Steam)', 'UnityEngine.UI.dll', System.IO.SearchOption.AllDirectories))">
        <Private>false</Private>
      </Reference>
      <Reference Include="$([System.IO.Directory]::GetFiles('$(PkgGorillaTag_GameLibs_Steam)', 'UnityEngine.UIModule.dll', System.IO.SearchOption.AllDirectories))">
        <Private>false</Private>
      </Reference>
      <Reference Include="$([System.IO.Directory]::GetFiles('$(PkgGorillaTag_GameLibs_Steam)', 'UnityEngine.TextRenderingModule.dll', System.IO.SearchOption.AllDirectories))">
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
