<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TvMenu</AssemblyName>
    <Description>TvMenu Gorilla Tag Mod Menu</Description>
    <Version>1.2.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.25" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>https://raw.githubusercontent.com/legoandmars/GorillaTagModTemplate/main/Libs/Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>https://raw.githubusercontent.com/legoandmars/GorillaTagModTemplate/main/Libs/PhotonUnityNetworking.dll</HintPath>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>https://raw.githubusercontent.com/legoandmars/GorillaTagModTemplate/main/Libs/PhotonRealtime.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
